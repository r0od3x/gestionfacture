# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sommier
DB_USER=postgres
DB_PASSWORD=change-me

# --- OCR tools ---
# Full path to tesseract.exe (leave empty if tesseract is on PATH)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=fra
# Folder containing pdftoppm.exe from Poppler (leave empty if on PATH)
POPPLER_PATH=C:\poppler\Library\bin

# --- Files ---
# Where generated attestations / calculation sheets are written
RESULT_DIR=./resultat
# Excel templates filled in by the export step
ATTESTATION_TEMPLATE=./templates/attestation.xlsx
CALCUL_TEMPLATE=./templates/calcul.xlsx
# Running log of processed calculations
CALCUL_LOG_FILE=./excelfiles/default.xlsx
